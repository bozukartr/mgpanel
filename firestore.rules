rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function signedIn() {
      return request.auth != null;
    }

    // True only for provisioned staff: a user who actually has a systemUsers
    // document. This blocks self-registered accounts (Firebase Auth signup is
    // open via the public API key) from touching any data.
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/systemUsers/$(request.auth.uid));
    }

    // Reads the caller's role from their own systemUsers document.
    function callerRole() {
      return get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isStaff() && callerRole() == 'Admin';
    }

    // Subscription must be active (subscriptionEnd in the future) for writes.
    function subActive() {
      return get(/databases/$(database)/documents/systemConfig/subscription).data.subscriptionEnd > request.time;
    }

    // --- Business data: provisioned staff only; writes also require active subscription ---
    match /reservations/{id} {
      allow read:  if isStaff();
      allow write: if isStaff() && subActive();
    }
    match /guestLogs/{id} {
      allow read:  if isStaff();
      allow write: if isStaff() && subActive();
    }
    match /guestDirectory/{id} {
      allow read:  if isStaff();
      allow write: if isStaff() && subActive();
    }

    // --- User accounts: staff can read the directory, only admin can modify roles ---
    match /systemUsers/{uid} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // --- System config (subscription, settings): read by staff, written by admin only ---
    match /systemConfig/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // --- Deny everything else by default ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
