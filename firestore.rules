rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reads the caller's role from their own systemUsers document.
    function callerRole() {
      return get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data.role;
    }

    // Case-insensitive: stored role may be 'Admin' or 'admin'.
    function isAdmin() {
      return signedIn() && callerRole().lower() == 'admin';
    }

    // --- Business data: any signed-in user ---
    match /reservations/{id}   { allow read, write: if signedIn(); }
    match /guestLogs/{id}      { allow read, write: if signedIn(); }
    match /guestDirectory/{id} { allow read, write: if signedIn(); }

    // --- User accounts ---
    match /systemUsers/{uid} {
      allow read:           if signedIn();
      allow create, delete: if isAdmin();
      // Admin can update anything; a user may only clear their own forced-password flag.
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false);
    }

    // --- System config (subscription, settings): read by any signed-in user, written by admin ---
    match /systemConfig/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // --- Deny everything else ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
