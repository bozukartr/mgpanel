rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reads the caller's role from their own systemUsers document.
    function callerRole() {
      return get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data.role;
    }

    // Case-insensitive: stored role may be 'Admin' or 'admin'.
    function isAdmin() {
      return signedIn() && callerRole().lower() == 'admin';
    }
    // Yönetici katmanı (rol matrisi — docs/restoran-uretim-plani.md):
    // menü/stok tanımı gibi işlemler manager VEYA admin ister.
    function isManagerOrAdmin() {
      return signedIn() && callerRole().lower() in ['admin', 'manager'];
    }

    // Platform (vendor) operator. Membership lives in a dedicated collection
    // that no tenant admin can write to, preventing privilege escalation.
    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    // A guest opens the QR self-service page (guest-order.html) signed in with
    // Anonymous Auth. Staff sign in with username/password. Distinguishing the
    // two lets us give guests a tightly-scoped, session-bound surface.
    // NOT: yalnızca isStaff() tanımlı — simetrik bir isAnon() de vardı ama
    // hiçbir kural onu ÇAĞIRMIYORDU. Çağrılmayan bir fonksiyonda `request`
    // bağlı olmadığından derleyici her deploy'da iki uyarı basıyordu
    // ("Unused function: isAnon" + "Invalid variable name: request").
    // Misafir dalı gerekirse `!isStaff()` zaten aynı ayrımı veriyor.
    function isStaff() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Anonim misafir oturumuna functions/index.js:mintGuestClaim tarafından
    // yazılan, Cloudflare Worker'ın imzaladığı GERÇEK subdomain'den türetilmiş
    // tenant claim'i. mintGuestClaim çağrılmadıysa (ör. Worker'ın önünde
    // olmayan yerel geliştirme, ya da istemci mint isteğini hiç göndermediyse)
    // null döner — bu durumda çağıran taraf kuralları GERİYE DÖNÜK UYUMLU
    // (claim'siz, eski) davranışa düşürmelidir; null asla "her şeye izin ver"
    // anlamına gelmemeli, yalnızca "doğrulanmış bilgi yok" anlamına gelir.
    function guestClaimTenant() {
      return request.auth.token.get('tenantId', null);
    }

    // Misafirin doğrulanmış oturumu (bkz. functions/index.js:verifyGuestIdentity)
    // — soyad+doğum yılı guestDirectory ile SUNUCU tarafında eşleştirilip
    // yalnızca Admin SDK ile buraya yazılır (istemci asla yazamaz, aşağıdaki
    // verifiedGuestSessions match bloğuna bakın). guestDirectory.status
    // kontrolü SAYESİNDE checkout anında (personel misafiri çıkışa aldığı an)
    // oturum otomatik geçersiz olur — ayrı bir "temizlik" fonksiyonu gerekmez.
    // Eşleşmezse/oturum yoksa null döner; null hiçbir gerçek oda değeriyle
    // ASLA eşleşmez (guestOrders.create'de kullanılışına bakın).
    function verifiedSessionRoom(tid) {
      let s = get(/databases/$(database)/documents/verifiedGuestSessions/$(request.auth.uid));
      return (s.data.tenantId == tid
        && get(/databases/$(database)/documents/guestDirectory/$(s.data.guestId)).data.get('status', '') == 'in_house')
        ? s.data.room : null;
    }
    // A room the hotel EXPLICITLY knows is closed (checked-out guest) can
    // never order — regardless of verifiedSessionRoom(). This is an
    // ADDITIONAL defense layer with a different source of truth (roomAccess
    // vs. verifiedGuestSessions/guestDirectory): it only blocks a room the
    // system has PROOF is closed (mirrored doc exists AND open==false); an
    // unmirrored/unknown room (hotel not using live occupancy tracking) is
    // left untouched — zero behavior change for hotels that never populate
    // roomAccess.
    function roomIsExplicitlyClosed(tid, room) {
      return exists(/databases/$(database)/documents/roomAccess/$(tid + '__' + room))
        && get(/databases/$(database)/documents/roomAccess/$(tid + '__' + room)).data.get('open', true) == false;
    }
    // GÜVENLİK DÜZELTMESİ: modifiers listesinin yalnızca ELEMAN SAYISI
    // (<=10) sınırlanıyordu, her elemanın KENDİ alan boyutları (name/type)
    // hiç kontrol edilmiyordu — 20 kalem × 10 modifier × sınırsız string
    // boyutuyla doküman şişirilip DoS/depolama suistimali yapılabilirdi
    // (diğer tüm alanlar — note/option/category — sıkı sınırlanmışken bu
    // alan atlanmıştı). validModifier/validModifiers, validGuestOrderItem
    // ile AYNI döngüsüz sabit-indeks açılım deseniyle her elemanı doğrular.
    function validModifier(m) {
      return m.name is string && m.name.size() > 0 && m.name.size() <= 60
        && m.get('type', 'remove') is string && m.get('type', 'remove').size() <= 20
        && m.get('priceDelta', 0) is number
        // group: misafir ekranındaki başlık (ör. "Soslar"); qty: aynı
        // ekstranın kaç kez istendiği (2× Ekstra Peynir). Diğer tüm alanlarla
        // AYNI desen — yalnızca tip/aralık sınırı, biçim doğrulaması yok.
        && m.get('group', '') is string && m.get('group', '').size() <= 40
        && m.get('qty', 1) is number && m.get('qty', 1) >= 1 && m.get('qty', 1) <= 10;
    }
    function validModifiers(mods) {
      return (mods.size() < 1  || validModifier(mods[0]))
        && (mods.size() < 2  || validModifier(mods[1]))
        && (mods.size() < 3  || validModifier(mods[2]))
        && (mods.size() < 4  || validModifier(mods[3]))
        && (mods.size() < 5  || validModifier(mods[4]))
        && (mods.size() < 6  || validModifier(mods[5]))
        && (mods.size() < 7  || validModifier(mods[6]))
        && (mods.size() < 8  || validModifier(mods[7]))
        && (mods.size() < 9  || validModifier(mods[8]))
        && (mods.size() < 10 || validModifier(mods[9]));
    }
    // Kalem şekli/aralığı doğrulaması (DoS/abuse önleme — aşırı miktar, dev
    // metin bloğu). İstemci tarafı sınırların (guest-order.js: MAX_QTY=10,
    // MAX_DISTINCT=20) sunucu tarafı garantisi. Rules dilinde döngü
    // olmadığından sabit indeks açılımı kullanılır (items zaten <=20).
    function validGuestOrderItem(it) {
      return it.name is string && it.name.size() > 0 && it.name.size() <= 120
        && (it.get('qty', 1) is number && it.get('qty', 1) >= 1 && it.get('qty', 1) <= 10)
        && (it.get('category', '') is string && it.get('category', '').size() <= 60)
        && (it.get('department', '') is string && it.get('department', '').size() <= 60)
        && (it.get('note', '') is string && it.get('note', '').size() <= 300)
        && (it.get('option', '') is string && it.get('option', '').size() <= 80)
        && (it.get('modifiers', []) is list && it.get('modifiers', []).size() <= 10 && validModifiers(it.get('modifiers', [])))
        // Transfer'e özel yapılandırılmış alanlar (Nereden/Nereye/Tarih/Saat)
        // — diğer tüm alanlarla AYNI desen: yalnızca tip/boyut sınırı,
        // format doğrulaması yok (personel için kozmetik, güvenlik değil).
        && (it.get('transferFrom', '') is string && it.get('transferFrom', '').size() <= 80)
        && (it.get('transferTo', '') is string && it.get('transferTo', '').size() <= 80)
        && (it.get('transferDate', '') is string && it.get('transferDate', '').size() <= 10)
        && (it.get('transferTime', '') is string && it.get('transferTime', '').size() <= 5)
        // Tahmini teslim süresi DAKİKA olarak, gönderim anında katalogdan
        // damgalanır (bkz. guest-order.js:submitOrder). 24 saatlik üst sınır
        // diğer alanlardaki boyut sınırlarıyla aynı DoS duruşunu korur.
        && (it.get('etaMin', 0) is number && it.get('etaMin', 0) >= 0 && it.get('etaMin', 0) <= 1440)
        && (it.get('etaMax', 0) is number && it.get('etaMax', 0) >= 0 && it.get('etaMax', 0) <= 1440);
    }
    function validGuestOrderItems(items) {
      return (items.size() < 1  || validGuestOrderItem(items[0]))
        && (items.size() < 2  || validGuestOrderItem(items[1]))
        && (items.size() < 3  || validGuestOrderItem(items[2]))
        && (items.size() < 4  || validGuestOrderItem(items[3]))
        && (items.size() < 5  || validGuestOrderItem(items[4]))
        && (items.size() < 6  || validGuestOrderItem(items[5]))
        && (items.size() < 7  || validGuestOrderItem(items[6]))
        && (items.size() < 8  || validGuestOrderItem(items[7]))
        && (items.size() < 9  || validGuestOrderItem(items[8]))
        && (items.size() < 10 || validGuestOrderItem(items[9]))
        && (items.size() < 11 || validGuestOrderItem(items[10]))
        && (items.size() < 12 || validGuestOrderItem(items[11]))
        && (items.size() < 13 || validGuestOrderItem(items[12]))
        && (items.size() < 14 || validGuestOrderItem(items[13]))
        && (items.size() < 15 || validGuestOrderItem(items[14]))
        && (items.size() < 16 || validGuestOrderItem(items[15]))
        && (items.size() < 17 || validGuestOrderItem(items[16]))
        && (items.size() < 18 || validGuestOrderItem(items[17]))
        && (items.size() < 19 || validGuestOrderItem(items[18]))
        && (items.size() < 20 || validGuestOrderItem(items[19]));
    }

    // The caller's hotel (tenant). FAIL-CLOSED: an untagged user (no tenantId
    // on their systemUsers doc) gets a sentinel that can never equal a real
    // tenant slug NOR a document's missing-tenant sentinel — so they match
    // nothing. Tag legacy users via backfillTenantTags before this is enforced.
    function callerTenant() {
      return get(/databases/$(database)/documents/systemUsers/$(request.auth.uid))
               .data.get('tenantId', 'NO_TENANT_USER');
    }
    // The caller's own username — used to mirror concierge.js's "only the
    // creator can delete" ownership check server-side (was client-only, so
    // any staff member of the tenant could delete ANY reservation via a
    // direct SDK/console call, bypassing the UI's password re-auth prompt).
    function callerUsername() {
      return get(/databases/$(database)/documents/systemUsers/$(request.auth.uid))
               .data.get('username', 'NO_USER');
    }

    // Tenant guards. FAIL-CLOSED: an untagged document defaults to a sentinel
    // distinct from the caller sentinel, so untagged docs are inaccessible to
    // everyone (an untagged caller never matches an untagged doc).
    function readOwnTenant() {
      return isSuperAdmin()
        || (signedIn() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
    }
    function writeOwnTenant() {
      return isSuperAdmin()
        || (signedIn() && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
    }

    // --- Business data: isolated per hotel (tenant) ---
    match /reservations/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant();
      allow update: if readOwnTenant() && writeOwnTenant();
      // concierge.js only lets the record's creator (staffInitial) delete it
      // (after a password re-auth prompt) — that check lived purely in
      // client JS. Mirrored here so it can't be bypassed by calling the SDK
      // directly; superadmin keeps its usual override via readOwnTenant().
      // QR-kaynaklı kayıtların staffInitial'ı hep sabit 'QR-Misafir' (bkz.
      // order-bridge.js) — gerçek bir personel adı ASLA buna eşit olmaz, bu
      // yüzden "yalnızca oluşturan silebilir" kuralı bu kayıtları HİÇBİR
      // personelin (admin dahil) silemediği bir duruma sokuyordu (bkz. QR
      // Concierge denetimi). Bu kayıtların "gerçek" bir sahibi olmadığından
      // (misafirden otomatik geldi), tenant'ın herhangi bir personeli
      // silebilir — update kuralı zaten aynı gevşeklikte (herhangi bir
      // personel serbestçe düzenleyebiliyor).
      allow delete: if readOwnTenant()
        && (isSuperAdmin()
          || resource.data.get('staffInitial', 'NO_CREATOR') == callerUsername()
          || resource.data.get('staffInitial', 'NO_CREATOR') == 'QR-Misafir');
    }
    // Misafirin tamamlanmış bir QR talebine verdiği 1-5 yıldız değerlendirme.
    // Tamamen sunucu-yazımlı — "bu kalem gerçekten bu misafirin oturumuna ait
    // mi / gerçekten tamamlandı mı / daha önce değerlendirildi mi" kontrolü
    // guestOrders ana dokümanının taze okunmasını ve AYNI transaction'da
    // idempotency damgasının (item.ratedAt) yazılmasını gerektiriyor — bu
    // rules'un deklaratif dilinde ifade edilemez, bu yüzden restAudit ile
    // AYNI desen (personel okur, hiçbir client yazamaz) izlenir; tek yazım
    // yolu functions/index.js:submitItemRating callable'ı.
    match /serviceRatings/{id} {
      allow read: if readOwnTenant();
      allow create, update, delete: if false;
    }
    match /guestLogs/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant();
      allow update: if readOwnTenant() && writeOwnTenant();
      allow delete: if readOwnTenant();
    }
    match /guestDirectory/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant();
      allow update: if readOwnTenant() && writeOwnTenant();
      allow delete: if readOwnTenant();
    }
    // Konaklamalar: kimlik modeli — guestId kişiyi, stays dokümanı tek bir
    // konaklamayı tanımlar (bkz. js/core/guest-directory.js). guestDirectory
    // ile aynı erişim şekli: otelin personeli okur/yönetir.
    match /stays/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant();
      allow update: if readOwnTenant() && writeOwnTenant();
      allow delete: if readOwnTenant();
    }
    // Kimlik migrasyonu inceleme kuyruğu: backfillGuestIdentity fonksiyonu
    // (Admin SDK) belirsiz/eşleşmeyen eski kayıtları buraya yazar — otomatik
    // tahmin YAPILMAZ. Otelin admin'i (veya operatör) inceleyip çözer;
    // istemciden yeni kayıt oluşturulamaz.
    match /migrationReview/{id} {
      allow read:   if isSuperAdmin() || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
      allow create: if false;
      allow update: if isSuperAdmin() || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
    }

    // --- Restaurant (POS) module, all tenant-scoped to the caller's hotel ---
    // Per-hotel restaurant settings (tax, currency, receipt). Admin writes.
    match /restConfig/{tid} {
      // Yalnızca personel sayfalarından okunur (restaurant.html) — misafir
      // akışı hiç kullanmaz, bu yüzden tenant kilidi kayıpsız uygulanabilir.
      allow read:  if signedIn() && tid == callerTenant();
      allow write: if isStaff() && isAdmin() && tid == callerTenant();
    }
    // Sıralı adisyon numarası sayacı (her personel artırabilir).
    match /restCounters/{tid} {
      allow read:  if isStaff() && tid == callerTenant();
      allow write: if isStaff() && tid == callerTenant();
    }
    // Menu, tables, checks (adisyon), cashier sessions, room-account folio.
    // Any staff member in the hotel may read/manage these (waiters open checks).
    // Menü/stok tanımı: yalnızca manager/admin yazabilir (Faz 4 — önceden
    // HER personel menü fiyatı/stok değiştirebiliyordu). Okuma tüm personel.
    match /restMenu/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant() && (isManagerOrAdmin() || isSuperAdmin());
      allow update: if readOwnTenant() && writeOwnTenant() && (isManagerOrAdmin() || isSuperAdmin());
      allow delete: if readOwnTenant() && (isManagerOrAdmin() || isSuperAdmin());
    }
    match /restTables/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant();
      allow update: if readOwnTenant() && writeOwnTenant();
      allow delete: if readOwnTenant();
    }
    // Adisyon durum makinesi (bkz. docs/restoran-uretim-plani.md Faz 3):
    //   open → open|sent|paid|void, sent → sent|paid|void
    //   paid/void kesin DEĞİŞTİRİLEMEZ ve SİLİNEMEZ (yalnız Admin SDK).
    //   version: her istemci güncellemesi tam +1 artırmak zorunda — bayat
    //   cihazın (eski version'la) yazması reddedilir. Eski dokümanlarda
    //   version yok → 0 kabul edilir, ilk güncelleme 1 yazar.
    //   NOT (geçiş dönemi): istemcinin paid/void YAZMASI Faz 4'te sunucu
    //   fonksiyonlarına taşınıp burada kapatılır; bu fazda yalnız
    //   "ödendikten sonra dokunulmaz" + sıra disiplini garanti edilir.
    match /restChecks/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant()
        && request.resource.data.get('status', 'open') in ['open', 'sent']
        && request.resource.data.get('version', 0) is int
        && request.resource.data.get('version', 0) >= 1;
      // Faz 4: istemci PAID/VOID YAZAMAZ — ödeme restSettleCheck, iptal
      // restVoidCheck fonksiyonlarından (Admin SDK) geçer; rules+functions+
      // hosting AYNI deploy'da gitmeli (plan §5).
      allow update: if readOwnTenant() && writeOwnTenant()
        && resource.data.get('status', 'open') in ['open', 'sent']
        && request.resource.data.get('status', 'open') in ['open', 'sent']
        && !(resource.data.get('status', 'open') == 'sent' && request.resource.data.get('status', 'open') == 'open')
        && request.resource.data.get('version', 0) == resource.data.get('version', 0) + 1;
      allow delete: if readOwnTenant()
        && resource.data.get('status', 'open') in ['open', 'sent'];
    }
    match /restSessions/{id} {
      allow read:   if readOwnTenant();
      allow create: if writeOwnTenant();
      allow update: if readOwnTenant() && writeOwnTenant();
      allow delete: if readOwnTenant();
    }
    // Oda hesabı kayıtları: TÜM yazımlar sunucu fonksiyonlarından geçer
    // (F4.5) — restoran ödemesi restSettleCheck, rezervasyon yansıtma
    // applyReservationFolio, kapatma restSettleFolio. İstemci yalnız okur.
    match /folioCharges/{id} {
      allow read:   if readOwnTenant();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // İdempotency defteri + denetim izi (Faz 4): YALNIZCA Admin SDK yazar.
    // restAudit'i otel admin'i (kendi tenant'ı) ve süperadmin okuyabilir.
    match /restOps/{id} {
      allow read, write: if false;
    }
    match /restAudit/{id} {
      allow read: if isSuperAdmin()
        || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
      allow create, update, delete: if false;
    }

    // --- User accounts: scoped to the caller's hotel ---
    match /systemUsers/{uid} {
      allow read: if readOwnTenant();
      // Tenant admins manage their own staff; superadmins can provision any hotel.
      allow create: if (isAdmin() && writeOwnTenant()) || isSuperAdmin();
      // Delete is gated on the EXISTING document (request.resource is null on delete).
      allow delete: if (isAdmin() && readOwnTenant()) || isSuperAdmin();
      // Admin/superadmin can update within their hotel; a user may only clear
      // their own forced-password flag.
      allow update: if (isAdmin() && readOwnTenant() && writeOwnTenant()) || isSuperAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false);
    }

    // --- Legacy global maintenance flag (kept for backward compatibility) ---
    match /systemConfig/maintenance {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // --- Per-hotel maintenance flags. Publicly readable so the guard can check
    //     before authentication; written only by that hotel's admin (or the
    //     platform operator). One hotel's maintenance never affects another. ---
    match /maintenance/{tid} {
      allow read:  if true;
      allow write: if isSuperAdmin() || (isAdmin() && tid == callerTenant());
    }

    // --- System config (legacy global subscription/settings) ---
    match /systemConfig/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // --- Support tickets: per-hotel, admins only ---
    match /tickets/{id} {
      allow read:   if isSuperAdmin() || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
      allow update: if isSuperAdmin() || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
    }

    // --- Tenant registry (hotels). A user may read only their own hotel;
    //     the platform operator (superadmin) reads/manages all. ---
    match /tenants/{tenantId} {
      allow read:  if isSuperAdmin() || (signedIn() && tenantId == callerTenant());
      allow write: if isSuperAdmin();
    }

    // --- Platform operators (vendor). Bootstrapped manually in the console;
    //     never writable from the client to avoid privilege escalation. ---
    match /superAdmins/{uid} {
      allow read:  if isSuperAdmin();
      allow write: if false;
    }

    // --- Per-hotel finance settings (commission rates). Read by the hotel's
    //     team, written by its admin (or the platform operator). ---
    match /financeConfig/{tid} {
      allow read:  if isSuperAdmin() || (signedIn() && tid == callerTenant());
      allow write: if isSuperAdmin() || (isAdmin() && tid == callerTenant());
    }

    // --- Payments. Written only by Cloud Functions (Admin SDK bypasses rules);
    //     a hotel admin may read their own hotel's payment history. ---
    match /payments/{oid} {
      allow read:  if isSuperAdmin() || (isAdmin() && resource.data.get('tenantId', '') == callerTenant());
      allow write: if false;
    }

    // --- Public checkout orders (from the marketing site). Created only by the
    //     Cloud Function (Admin SDK bypasses rules). The platform operator can
    //     read all, annotate/archive (limited fields only — never status, amount
    //     or buyer details), and delete. ---
    match /checkoutOrders/{oid} {
      allow read:   if isSuperAdmin();
      allow create: if false;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['note', 'archived', 'archivedAt']);
      allow delete: if isSuperAdmin();
    }

    // --- Presence: who is currently online, per hotel. Each user maintains
    //     their OWN document (id = uid) via a heartbeat; teammates in the same
    //     hotel may read the roster to assign live requests. ---
    match /presence/{uid} {
      allow read:   if signedIn() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // --- In-app notifications. A teammate creates one addressed to another
    //     user (toUid) in the same hotel; only the recipient can read it, and
    //     may only flip it to read. ---
    // GÜVENLİK DÜZELTMESİ: eskiden yalnızca gönderenin (fromUid) kimliği ve
    // tenantId alanı kontrol ediliyordu — toUid'nin GERÇEKTEN aynı tenant'a
    // ait olduğu hiç doğrulanmıyordu, ve title/body gibi alanlara boyut/şekil
    // sınırı yoktu. Bu, herhangi bir otelin personelinin BAŞKA bir otelin
    // personeline (toUid'sini tahmin/bilerek) sınırsız içerikli bildirim
    // enjekte edip okutabilmesine (cross-tenant spam/phishing) açık
    // bırakıyordu. targetTenant() ile hedefin KENDİ tenant'ı (systemUsers
    // dokümanından) okunup çağıranınkiyle eşleştirilir.
    function targetTenant(uid) {
      return get(/databases/$(database)/documents/systemUsers/$(uid)).data.get('tenantId', 'NO_TENANT_USER');
    }
    // create'de doğrulanan şekil/boyut kurallarını tek yerde toplar — hem
    // `allow create` hem de gönderenin AYNI idempotency penceresi içinde
    // kendi bildirimini set({merge:true}) ile yeniden yazdığı `allow update`
    // dalı (bkz. js/core/realtime.js:RT.sendNotification — deterministik
    // ID + dakika-penceresi ile mükerrer bildirimi önler) AYNI şekli
    // paylaşsın diye.
    function validNotification(d) {
      return d.keys().hasOnly(
              ['tenantId', 'toUid', 'toUsername', 'fromUid', 'fromUsername', 'title', 'body', 'recordId', 'type', 'read', 'createdAt'])
        && d.get('tenantId', 'NO_TENANT_DOC') == callerTenant()
        && d.fromUid == request.auth.uid
        && d.toUid is string && d.toUid.size() > 0
        && targetTenant(d.toUid) == callerTenant()
        && d.get('title', '') is string && d.get('title', '').size() <= 200
        && d.get('body', '') is string && d.get('body', '').size() <= 500
        && d.get('recordId', '') is string && d.get('recordId', '').size() <= 200;
    }
    match /notifications/{id} {
      allow read:   if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn() && validNotification(request.resource.data);
      allow update: if signedIn() && (
            // Alıcı yalnızca 'read' bayrağını çevirebilir.
            (resource.data.toUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
            // GÖNDEREN, KENDİ gönderdiği bir bildirimi (fromUid sahipliği +
            // AYNI create-şekli) yeniden yazabilir — RT.sendNotification'ın
            // set({merge:true}) ile aynı dakika-penceresindeki yeniden
            // denemesi/çift tıklaması burada "update" olarak değerlendirilir
            // (doküman zaten var); bu dal olmadan yalnızca ilk create
            // başarılı olur, idempotent yeniden deneme permission-denied
            // alırdı.
            || (resource.data.fromUid == request.auth.uid && validNotification(request.resource.data))
          );
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    // --- FCM device tokens for web push. A user registers their OWN device
    //     tokens (doc id = token); the sender Cloud Function (Admin SDK) reads
    //     them to deliver pushes. Not readable by other clients. ---
    match /pushTokens/{token} {
      allow read:   if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Quote requests from the public marketing site (hotizy.com). Anyone
    //     may create one (lead form) but only with the expected fields and
    //     sane sizes; the platform operator reads, annotates and deletes. ---
    match /quoteRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['hotel', 'name', 'email', 'phone', 'rooms', 'hotels', 'message', 'status', 'source', 'createdAt'])
        && request.resource.data.hotel is string && request.resource.data.hotel.size() > 0 && request.resource.data.hotel.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'new';
      allow read:   if isSuperAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note']);
      allow delete: if isSuperAdmin();
    }

    // --- PMS integration config (per hotel). Holds the hotel's API key, so
    //     ONLY the platform operator can read/write it from a client; hotel
    //     staff never touch it. The pmsLookup Cloud Function reads it with the
    //     Admin SDK (bypasses rules) to proxy guest lookups. ---
    match /pmsConfig/{tid} {
      allow read, write: if isSuperAdmin();
    }

    // --- OAuth2 access token cache for the PMS adapter (short-lived bearer
    //     tokens). Split out of pmsConfig on purpose: pmsConfig is readable by
    //     superadmin from the client (for the settings form), and a live
    //     bearer token has no business being fetchable by any client SDK call,
    //     even a superadmin one — only the Cloud Function (Admin SDK, bypasses
    //     rules) needs it. Deny-all here is what actually enforces that. ---
    match /pmsOAuthCache/{tid} {
      allow read, write: if false;
    }

    // Misafirin doğrulanmış oturumu (bkz. verifiedSessionRoom() yukarıda) —
    // yalnızca functions/index.js:verifyGuestIdentity tarafından Admin SDK
    // ile yazılır (kurallardan bağımsız). İstemciye (misafir veya personel
    // farketmez) hiçbir zaman doğrudan okuma/yazma izni verilmez — misafir
    // kendi odasını kendi oturumuna sahte olarak yazamasın diye.
    match /verifiedGuestSessions/{uid} {
      allow read, write: if false;
    }

    // --- Apex marketing site display mode (Açık / Yakında / Bakımda). Publicly
    //     readable so index.html can gate itself before auth; written only by the
    //     platform operator (superadmin). ---
    match /siteConfig/{id} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // --- Guest self-service page settings (per hotel): display name shown to
    //     guests, whether prices / the "recommended" row appear, currency. Any
    //     signed-in client (incl. anonymous guests) may READ it; only the hotel's
    //     admin writes it. Holds no guest data. ---
    match /guestConfig/{tid} {
      // Personel her zaman kendi oteline kilitli. Anonim misafir: Worker'ın
      // imzaladığı doğrulanmış claim VARSA yalnızca kendi oteline kilitli;
      // claim yoksa (mintGuestClaim çağrılmadı/başarısız oldu) eski açık
      // davranışa düşülür — geriye dönük uyumlu, hiçbir şey kırılmaz.
      allow read:  if signedIn() && (
        (isStaff() && tid == callerTenant())
        || (!isStaff() && (guestClaimTenant() == null || guestClaimTenant() == tid))
      );
      allow write: if isStaff() && isAdmin() && tid == callerTenant();
    }

    // --- Per-hotel notification settings (admin "Bildirimler" sekmesi). The
    //     onGuestOrderCreate Cloud Function reads this with the Admin SDK to
    //     customize the new-request push (title, show items, recipients, on/off).
    //     Staff of the hotel may read; only the hotel's admin writes. ---
    match /notifyConfig/{tid} {
      allow read:  if isStaff() && tid == callerTenant();
      allow write: if isStaff() && isAdmin() && tid == callerTenant();
    }

    // --- Vardiya konumu (per hotel): otel merkezi + yarıçap. Personel bu
    //     ayarı OKUR (kendi vardiya durumunu hesaplamak/panel.js katı kural
    //     kontrolü için — bkz. realtime.js/panel.js); yalnızca admin yazar.
    //     Personelin ham konumu BURADA DEĞİL — presence/{uid} içinde, yalnız
    //     hesaplanan sonuç (onShift) olarak durur. ---
    match /shiftConfig/{tid} {
      allow read:  if isStaff() && tid == callerTenant();
      allow write: if isStaff() && isAdmin() && tid == callerTenant();
    }

    // --- Issue (guest-record) departments & topics (per hotel). The list of
    //     departments and their sub-topics used by "Misafir Kayıtları" for both
    //     talep and şikayet. Any signed-in staff member READS it; only the
    //     hotel's admin writes it. Holds no guest data. ---
    match /issueConfig/{tid} {
      // Yalnızca personel sayfalarından okunur (admin/panel/reports) —
      // misafir akışı hiç kullanmaz, tenant kilidi kayıpsız uygulanabilir.
      allow read:  if signedIn() && tid == callerTenant();
      allow write: if isStaff() && isAdmin() && tid == callerTenant();
    }

    // --- Konular (complaint topics). One doc per topic, tenant-scoped. Any staff
    //     member may ADD a topic while logging a complaint (so the suggestion list
    //     fills itself); only the hotel's admin may DELETE one. Holds no guest
    //     data — just the curatable list of topic labels. ---
    match /issueTopics/{id} {
      // Yalnızca personel sayfalarından okunur (issue-config.js: admin/panel/
      // reports) — misafir akışı hiç kullanmaz, tenant kilidi kayıpsız.
      allow read:   if signedIn() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow create: if isStaff()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow delete: if isStaff() && isAdmin()
        && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
    }

    // --- Guest self-service request catalog (admin-managed "menu"). Any signed-in
    //     client may READ it — including anonymous guests on the QR page — but
    //     only the hotel's own admin can add/edit/remove items. The catalog holds
    //     no guest data, just the list of services the hotel offers. ---
    match /requestCatalog/{id} {
      // guest-order.js gerçekten anonim misafirden okur. STAFF her zaman
      // kendi oteline kilitli. Anonim tarafta doğrulanmış claim VARSA aynı
      // kilit uygulanır; claim yoksa eski açık davranışa düşülür (geriye
      // dönük uyumlu).
      allow read:   if signedIn() && (
        (isStaff() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant())
        || (!isStaff() && (guestClaimTenant() == null || guestClaimTenant() == resource.data.get('tenantId', 'NO_TENANT_DOC')))
      );
      allow create: if isStaff() && isAdmin()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow update: if isStaff() && isAdmin()
        && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow delete: if isStaff() && isAdmin()
        && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
    }

    // --- Guest-facing PDF menus ("Menüler" carousel card). Admin pastes a
    //     hosted PDF link (no Storage upload); guests only ever read the list.
    //     Same read/write shape as requestCatalog. ---
    match /guestMenus/{id} {
      // Aynı desen: STAFF her zaman kendi oteline kilitli; anonim tarafta
      // claim varsa aynı kilit, yoksa geriye dönük uyumlu açık davranış.
      allow read:   if signedIn() && (
        (isStaff() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant())
        || (!isStaff() && (guestClaimTenant() == null || guestClaimTenant() == resource.data.get('tenantId', 'NO_TENANT_DOC')))
      );
      allow create: if isStaff() && isAdmin()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow update: if isStaff() && isAdmin()
        && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow delete: if isStaff() && isAdmin()
        && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
    }

    // --- Guest self-service orders. A guest (anonymous session) creates an order
    //     bound to their own uid and may read ONLY their own orders; they can
    //     cancel one while it is still pending. The hotel's staff see and manage
    //     every order in their tenant. Tenant and session owner are immutable. ---
    match /guestOrders/{id} {
      allow read: if (isStaff() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant())
        || (signedIn() && resource.data.get('sessionUid', '') == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.sessionUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId.size() > 0 && request.resource.data.tenantId.size() <= 40
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20
        && validGuestOrderItems(request.resource.data.items)
        // Doğrulama artık TÜM oteller için ZORUNLU (eski opsiyonel
        // requireVerification anahtarı kaldırıldı): sipariş yalnızca,
        // misafirin verifyGuestIdentity ile SUNUCU tarafında doğrulanmış
        // GERÇEK odasıyla eşleşirse oluşturulabilir — istemcinin gönderdiği
        // room değeri (eskiden URL'den okunuyordu) artık tek başına HİÇBİR
        // ŞEY kanıtlamaz, yalnızca doğrulanmış oturumla eşleşmesi gerekir.
        && request.resource.data.room == verifiedSessionRoom(request.resource.data.tenantId)
        // Sistemin KANITLA bildiği (check-out yapılmış) bir odaya yeni
        // sipariş açılamaz — ek savunma katmanı (farklı kaynak: roomAccess).
        && !roomIsExplicitlyClosed(request.resource.data.tenantId, request.resource.data.room)
        // Worker-doğrulanmış claim VARSA sipariş yalnızca o gerçek tenant'a
        // yazılabilir (?tenant= veya başka bir client-taraflı iddia ile
        // farklı bir otele sahte sipariş enjekte edilemez). Claim yoksa
        // (Worker'ın önünde olmayan ortam) eski davranışa düşülür.
        && (guestClaimTenant() == null || guestClaimTenant() == request.resource.data.tenantId);

      // Staff manage status/assignment within their hotel (tenant + owner frozen).
      // GÜVENLİK/OPERASYONEL DÜZELTME: misafirin kendi siparişini doğrudan
      // `.update({status:'cancelled'})` ile iptal edebildiği eski OR-dalı
      // KALDIRILDI — artık tek yol `cancelGuestOrder`/`cancelGuestOrderItem`
      // Cloud Function'ları (Admin SDK, kuralları atlar). Bu callable'lar
      // guestOrders İLE bağlı guestLogs/reservations dokümanlarını TEK bir
      // transaction'da senkronize ediyor; eski direkt-yazım yolu canlı
      // kalsaydı bu senkronu tamamen atlayan bir bypass olurdu (bağlı
      // dokümanlar yetim kalırdı — bkz. Concierge/Transfer çift-yönlü
      // senkron denetimi).
      allow update: if isStaff()
            && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant()
            && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == resource.data.get('tenantId', 'NO_TENANT_DOC')
            && request.resource.data.get('sessionUid', '') == resource.data.get('sessionUid', '');

      allow delete: if isStaff() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
    }

    // --- Per-room access state. Mirrored from the hotel's live occupancy by
    //     staff clients (room-access.js): holds only whether the room
    //     currently accepts requests (`open`) — read internally (via get())
    //     by roomIsExplicitlyClosed() in guestOrders.create; that internal
    //     read is NOT subject to this match's `allow` rules, so no client
    //     (staff or guest) needs direct read access anymore. Misafir kimlik
    //     doğrulaması artık burada değil, verifiedGuestSessions/guestDirectory
    //     üzerinden yapılıyor (bkz. verifyGuestIdentity/verifiedSessionRoom). ---
    match /roomAccess/{id} {
      // STAFF callers carry a real tenant (their own systemUsers doc), so
      // `get` is locked to their own hotel's rooms — closes the cross-tenant
      // leak where any hotel's logged-in staff could read another hotel's
      // live room-occupancy by guessing `{tenantId}__{room}`. No staff UI
      // reads this today, but the rule stays tenant-scoped rather than
      // wide-open in case one is added later. Anonymous guests get NO read
      // access at all (unlike before) — the client no longer needs it.
      // `list` stays denied outright (stops bulk enumeration).
      allow get:  if isStaff() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow list: if false;
      // GÜVENLİK DÜZELTMESİ: eskiden yalnızca request.resource.data.tenantId
      // kontrol ediliyordu — doküman ID'sinin (tenantId + '__' + room)
      // GERÇEKTEN o tenant'a ait olduğu hiç doğrulanmıyordu. Bir otelin
      // personeli kendi tenantId'siyle ama BAŞKA bir otelin ID'sini taşıyan
      // (ör. "hotel-b__101") bir doküman yazabiliyordu; roomIsExplicitlyClosed()
      // yalnızca ID'ye bakıp `open` alanını okuduğundan bu, başka bir otelin
      // GERÇEK bir odasını kalıcı olarak "kapalı" işaretleyip o odanın
      // misafirlerinin QR sipariş vermesini engelleyen bir cross-tenant DoS'a
      // açık kapı bırakıyordu (tenant ID'ler subdomain'den, oda numaraları da
      // kolayca tahmin edilebilir olduğundan pratik bir saldırı yüzeyiydi).
      // id.split('__')[0] ile ID'nin GERÇEKTEN çağıranın tenant'ıyla
      // başladığı doğrulanır (tenant slug'ları '__' içeremez — yalnızca
      // [a-z0-9-] — bu yüzden split her zaman doğru öneki izole eder).
      // update ayrıca dokümanın MEVCUT sahibini de doğrular (diğer
      // koleksiyonlardaki writeOwnTenant deseniyle aynı) — aksi halde
      // var olan, meşru bir dokümanın sahipliği create/update ile başka
      // bir tenant'a devralınabilirdi.
      allow create: if isStaff()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant()
        && id.split('__')[0] == callerTenant();
      allow update: if isStaff()
        && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant()
        && id.split('__')[0] == callerTenant();
      allow delete:        if isStaff()
        && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
    }

    // --- İstemci hata günlükleri (kendi içinde izleme; monitor.js) ---
    //     Yalnızca personel (anonim olmayan) kendi tenant'ı için oluşturabilir;
    //     anonim QR misafirleri yazamaz. Yalnızca o tenant'ın admin'i ve vendor
    //     (superadmin) okuyabilir. Kayıtlar değiştirilemez; temizliği superadmin
    //     yapar.
    match /errorLogs/{id} {
      allow create: if isStaff()
        && request.resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant();
      allow read:   if isSuperAdmin()
        || (isAdmin() && resource.data.get('tenantId', 'NO_TENANT_DOC') == callerTenant());
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // --- Süperadmin "Stres" sekmesi: kendi sağlık kontrolümüz. Tarayıcıdan
    //     doğrudan yazılıp okunan bir "ping" belgesi ile Firestore gidiş-dönüş
    //     gecikmesi ölçülür. Tenant verisiyle hiçbir ilişkisi yoktur; yalnızca
    //     platform operatörü erişebilir. (İzole yük testi `_stressTest`
    //     koleksiyonuna Admin SDK ile yazılır — kurallar orada devre dışıdır,
    //     bu yüzden ayrı bir match'e gerek yoktur.) ---
    match /_health/{id} {
      allow read, write: if isSuperAdmin();
    }

    // --- Deny everything else ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
