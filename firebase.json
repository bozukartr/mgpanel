{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "panel-d25c9",
    "public": ".",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/api/lemon-checkout", "function": { "functionId": "lemonCheckout", "region": "us-central1" } },
      { "source": "/api/lemon-webhook", "function": { "functionId": "lemonWebhook", "region": "us-central1" } },
      { "source": "/api/mint-guest-claim", "function": { "functionId": "mintGuestClaim", "region": "us-central1" } }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "cloudflare/**",
      "wrangler.jsonc",
      "README.md",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=600, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|ico|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/{login,app,panel,concierge,crm,admin,dashboard,restaurant,reports,superadmin,guest-order,maintenance,apex-bakim,apex-yakinda,payment-result}",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/{login,app,panel,concierge,crm,admin,dashboard,restaurant,reports,superadmin,guest-order,maintenance,apex-bakim,apex-yakinda,payment-result}.html",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  }
}
