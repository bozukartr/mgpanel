{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "panel-d25c9",
    "public": ".",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/api/mint-guest-claim", "function": { "functionId": "mintGuestClaim", "region": "us-central1" } }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "cloudflare/**",
      "wrangler.jsonc",
      "README.md",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=600, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "_comment": "cleanUrls:true olduğundan sayfalar UZANTISIZ adresten servis ediliyor (/admin, /panel, …) ve bu istek yolu '**/*.html' glob'una UYMUYOR — o adresler yukarıdaki no-cache kuralını hiç almıyordu. Sonuç: dağıtım sonrası tarayıcı ESKİ HTML'i, 10 dakikalık JS kuralı yüzünden YENİ JS ile birlikte gösterebiliyor; yeni JS'in aradığı alanlar eski HTML'de olmadığı için sayfa çöküyordu (bkz. request-catalog.js openModal). X-Robots-Tag kuralı zaten her iki biçimi de listeliyor — Cache-Control atlanmış.",
        "source": "/{,index,login,app,panel,concierge,crm,admin,dashboard,restaurant,reports,superadmin,guest-order,maintenance,apex-bakim,apex-yakinda,fiyatlandirma,hakkimizda}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|ico|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/{login,app,panel,concierge,crm,admin,dashboard,restaurant,reports,superadmin,guest-order,maintenance,apex-bakim,apex-yakinda}",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/{login,app,panel,concierge,crm,admin,dashboard,restaurant,reports,superadmin,guest-order,maintenance,apex-bakim,apex-yakinda}.html",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  }
}
