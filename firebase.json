{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "panel-d25c9",
    "public": ".",
    "cleanUrls": true,
    "rewrites": [
      { "source": "/api/lemon-checkout", "function": { "functionId": "lemonCheckout", "region": "us-central1" } },
      { "source": "/api/lemon-webhook", "function": { "functionId": "lemonWebhook", "region": "us-central1" } }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "README.md",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|ico|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ]
  }
}
